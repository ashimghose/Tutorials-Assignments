APP_NAME="Tutorials and Assignments"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Phases 0-1: SQLite file, no Docker. Phase 2 with Sail (docs/portal.md): use
# DB_CONNECTION=pgsql DB_HOST=pgsql DB_PORT=5432 DB_DATABASE=laravel DB_USERNAME=sail DB_PASSWORD=password
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# With Sail, emails go to Mailpit at http://localhost:8025:
# MAIL_MAILER=smtp MAIL_HOST=mailpit MAIL_PORT=1025
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ========== Rollout ==========
# 0 = Listen (static site), 1 = Sell by hand, 2 = Platform core, 3 = Own classroom
APP_PHASE=0
# Phase 2+ modules; switch on when that milestone is built and tested
# FEATURE_ACCOUNTS: logins, sign-up, parent/student/teacher portal (M3)
FEATURE_ACCOUNTS=false
# FEATURE_CMS: site content, campaign pages and enquiry forms from the admin panel (M4)
FEATURE_CMS=false
# FEATURE_BATCHES: tuition batches, class timetables and enrolments (M5)
FEATURE_BATCHES=false
FEATURE_CHECKOUT=false
FEATURE_ACADEMIC_ORDERS=false

# M6 academic orders. GST percent added to prices and quotes (ask the accountant);
# private disk for order files (an R2 disk in production); days files are kept
# after an order is finished or cancelled.
ACADEMIC_GST_PERCENT=18
ORDER_FILES_DISK=local
ORDER_FILE_RETENTION_DAYS=180
# FEATURE_CHAT: in-app messages, notices and opt-in marketing emails (M7)
FEATURE_CHAT=false
# Chat office hours in India time (days: Monday = 1); outside them the chat says when we'll reply.
CHAT_OFFICE_DAYS=1,2,3,4,5,6
CHAT_OFFICE_OPENS=10:00
CHAT_OFFICE_CLOSES=19:00
FEATURE_LIVE_CLASSROOM=false
FEATURE_RECORDINGS=false

# ========== Phase 0–1: marketing and contact ==========
# WhatsApp numbers in international format without + or spaces, e.g. 9198XXXXXXXX.
# These are public on the site. Tuition and academic pages use their own number;
# the home, contact and other pages (and a section left blank) use WHATSAPP_NUMBER.
WHATSAPP_NUMBER=919888727082
WHATSAPP_NUMBER_TUITION=919888727082
WHATSAPP_NUMBER_ACADEMIC=919958067504
WHATSAPP_TEXT_GENERAL="Hi, I have a question"
WHATSAPP_TEXT_TUITION="Hi, I'm asking about tuition"
WHATSAPP_TEXT_ACADEMIC="Hi, I'm asking about academic services"
CONTACT_EMAIL=
OFFICE_HOURS="Monday to Saturday, 10 am to 7 pm IST"
BUSINESS_CITY=
# Google Forms: paste each form's share link (ending in /viewform).
# The ENTRY values are the entry.NNNN ids of the hidden questions; see docs/google-forms.md
FORM_URL_TUITION=
FORM_TUITION_ENTRY_SOURCE=
FORM_TUITION_ENTRY_MEDIUM=
FORM_TUITION_ENTRY_CAMPAIGN=
FORM_TUITION_ENTRY_PAGE=
FORM_TUITION_ENTRY_INTEREST=
FORM_URL_ACADEMIC=
FORM_ACADEMIC_ENTRY_SOURCE=
FORM_ACADEMIC_ENTRY_MEDIUM=
FORM_ACADEMIC_ENTRY_CAMPAIGN=
FORM_ACADEMIC_ENTRY_PAGE=
FORM_ACADEMIC_ENTRY_INTEREST=
FORM_URL_WAITLIST=
FORM_WAITLIST_ENTRY_SOURCE=
FORM_WAITLIST_ENTRY_MEDIUM=
FORM_WAITLIST_ENTRY_CAMPAIGN=
FORM_WAITLIST_ENTRY_PAGE=
FORM_WAITLIST_ENTRY_INTEREST=
# Cloudflare Web Analytics site token (public pages only)
CF_ANALYTICS_TOKEN=
# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX (loads only after a visitor accepts cookies)
GA_MEASUREMENT_ID=
# Display time zone (storage stays UTC)
DISPLAY_TIMEZONE=Asia/Kolkata
# Stored with every consent; change when the lawyer-approved wording changes
CONSENT_POLICY_VERSION=draft-2026-10

# ========== Razorpay (Test Mode keys from the Razorpay dashboard) ==========
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ========== Cloudflare R2 (Phase 2+ production; S3-compatible disk "r2") ==========
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
# Separate private bucket for the nightly database backups
R2_BACKUP_BUCKET=

# ========== Backups (nightly, database only, kept 30 days) ==========
# local while developing; r2-backups in production
BACKUP_DISK=local
# Encrypts each backup zip; keep a copy somewhere safe outside the server
BACKUP_ARCHIVE_PASSWORD=
# Who gets the backup emails (defaults to CONTACT_EMAIL)
BACKUP_NOTIFY_EMAIL=

# ========== Phase 3: LiveKit (local dev values; replace with Cloud or self-hosted) ==========
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
RECORDING_RETENTION_DAYS=180
