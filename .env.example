APP_NAME="Tutorials and Assignments"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ========== Rollout ==========
# 0 = Listen (static site), 1 = Sell by hand, 2 = Platform core, 3 = Own classroom
APP_PHASE=0
# Phase 2+ modules; switch on when that milestone is built and tested
FEATURE_ACCOUNTS=false
FEATURE_CHECKOUT=false
FEATURE_ACADEMIC_ORDERS=false
FEATURE_CHAT=false
FEATURE_LIVE_CLASSROOM=false
FEATURE_RECORDINGS=false

# ========== Phase 0–1: marketing and contact ==========
# WhatsApp number in international format without + or spaces, e.g. 9198XXXXXXXX
WHATSAPP_NUMBER=
WHATSAPP_TEXT_TUITION="Hi, I'm asking about tuition"
WHATSAPP_TEXT_ACADEMIC="Hi, I'm asking about academic services"
FORM_URL_TUITION=
FORM_URL_ACADEMIC=
FORM_URL_WAITLIST=
CF_ANALYTICS_TOKEN=
# Display time zone (storage stays UTC)
DISPLAY_TIMEZONE=Asia/Kolkata

# ========== Razorpay (Test Mode keys from the Razorpay dashboard) ==========
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# GST on service prices, in basis points (1800 = 18%)
GST_RATE_BPS=1800

# ========== Cloudflare R2 (Phase 2+ production; S3-compatible disk "r2") ==========
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto

# ========== Academic orders ==========
ORDER_FILE_MAX_MB=25
ORDER_FILE_RETENTION_DAYS=90

# ========== Chat ==========
CHAT_FILE_MAX_MB=10
CHAT_UNREAD_EMAIL_MINUTES=15

# ========== Phase 3: LiveKit (local dev values; replace with Cloud or self-hosted) ==========
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
RECORDING_RETENTION_DAYS=180
